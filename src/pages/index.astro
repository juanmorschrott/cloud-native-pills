---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const target = getRelativeLocaleUrl(config.site.lang, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>cloud-native-pills</title>
  </head>
  <body>
    <a href={target}>cloud-native-pills</a>
  </body>
</html>
